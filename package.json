{
  "name": "@kontent-ai/cli",
  "version": "0.9.0-preview.1",
  "description": "Kontent.ai command-line interface",
  "type": "module",
  "main": "./dist/index.mjs",
  "bin": {
    "kontent": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontent-ai/cli.git"
  },
  "bugs": {
    "url": "https://github.com/kontent-ai/cli/issues"
  },
  "homepage": "https://github.com/kontent-ai/cli#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "start": "node dist/index.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "biome:check": "biome check",
    "biome:fix": "biome check --fix --unsafe",
    "prepare": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "kontent",
    "kontent-ai",
    "kontent.ai",
    "cli",
    "headless-cms",
    "cms"
  ],
  "author": "Kontent.ai <devrel@kontent.ai>",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@kontent-ai/biome-config": "^0.7.0",
    "@kontent-ai/eslint-config": "^2.4.1",
    "@types/node": "^22.13.10",
    "@types/yargs": "^17.0.35",
    "eslint": "^9.39.4",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@amplitude/analytics-node": "^1.5.59",
    "@clack/prompts": "^1.2.0",
    "@kontent-ai/core-sdk": "12.0.0-preview.40",
    "@kontent-ai/core-sdk-v10": "npm:@kontent-ai/core-sdk@10.12.5",
    "@kontent-ai/management-sdk": "^8.5.1",
    "@napi-rs/keyring": "^1.2.0",
    "chalk": "^5.6.2",
    "ci-info": "^4.4.0",
    "giget": "^3.2.0",
    "open": "^10.2.0",
    "openid-client": "^5.7.1",
    "ts-pattern": "^5.9.0",
    "yargs": "^18.0.0",
    "zod": "^4.0.0"
  }
}
